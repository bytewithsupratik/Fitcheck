# ==============================================================================
# FITCHECK PRODUCTION ENVIRONMENT & BACKEND API CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in your actual backend URLs and secret API keys.
# Vite exposes variables prefixed with `VITE_` to client-side code.

# 1. CORE BACKEND REST / GRAPHQL API
# The base URL of your FastAPI, Express/Node, Django, or Go backend service.
VITE_API_BASE_URL=https://api.fitcheck.app/v1

# Primary API Key used to authenticate client requests with the backend gateway.
VITE_API_KEY=fc_live_pk_9942a78e10c04f6b89c316

# 2. DATABASE & ORM CONFIGURATION (Node / Serverless / Supabase / PostgreSQL)
# If using Supabase / Firebase / Hasura directly from client or Edge Functions:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. GITHUB API INTEGRATION
# Client ID for GitHub OAuth, repository AST scanning, and commit verification.
VITE_GITHUB_CLIENT_ID=Ov23li...
VITE_GITHUB_API_BASE_URL=https://api.github.com

# 4. AI / CODE EVALUATION ENGINE API KEYS (Anthropic, Gemini, OpenAI)
# Used by the Technical Gym for AST code audits, complexity metrics, and feedback.
VITE_AI_CODE_EVAL_API_KEY=sk-ant-api03-...

# 5. WEBSOCKET TELEMETRY ENDPOINT
# Real-time WebSocket connection for live telemetry, readiness, and active presence.
VITE_WS_TELEMETRY_URL=wss://api.fitcheck.app/v1/telemetry

